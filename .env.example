# Copy to .env and fill in. The portal token is also read from ../lio-key.env (BEARER=...).

# Soony portal
LIO_TOKEN=
LIO_BASE_URL=https://start-hack-portal-cxh3crbdaef2f8gt.westeurope-01.azurewebsites.net

# live = poll the portal, replay = run from stored snapshots in data/archive
SOURCE=live
SYNC_INTERVAL_SEC=180
# In replay mode: seconds between snapshots (0 = only advance when asked in the dashboard)
REPLAY_INTERVAL_SEC=0

# The customer. Everything else the agents should know about it goes into prompts/customer.md
CUSTOMER_NAME=Soony
TIMEZONE=Europe/Berlin

# Launch deadline at the distribution center, and the packing shifts until then
DEADLINE=2026-11-22T20:00:00+01:00
SHIFTS=2026-11-21T06:00:00+01:00/2026-11-21T22:00:00+01:00,2026-11-22T06:00:00+01:00/2026-11-22T20:00:00+01:00
# Freeze the clock for testing (ISO). Empty = real time (live) or snapshot time (replay)
NOW=

# Value of one unit of a currency in EUR, to compare order values with approval limits
FX_TO_EUR=USD=0.92,CNY=0.13,INR=0.011,PLN=0.23
# Hours without a tracking update after which a moving shipment counts as stale
TRACKING_MAX_AGE_HOURS=sea=36,air=8,road=6

# How supply is counted (all optional)
# Time assumed for an arrival date without a time. 23:59 is the careful reading.
ETA_DATE_ONLY_TIME=23:59
# Hours between arrival at the distribution center and the first unit on the line
INBOUND_HANDLING_HOURS=0
# Onward leg in hours when no route from the port or airport to the site is on file
UNKNOWN_ONWARD_LEG_HOURS=24
# Take parts packed since the stock count off the stock figure
STOCK_ADJUST_FOR_PACKING=true
# Count packing capacity from the time of the last packed figure (packed_fact) or from now
CAPACITY_FROM=packed_fact
LOCAL_UTC_OFFSET=+01:00

# Agents (all optional)
DOCS_PER_CYCLE=60
# Most tool rounds per document for the reading agent, and for the clarification round
READER_MAX_STEPS=16
CLARIFY_MAX_STEPS=30
RISK_AGENT_MAX_STEPS=40
# Hold the risk agent back while documents are still waiting to be read
RISK_AGENT_WAIT_FOR_DOCUMENTS=true
ACTION_MAX_OPTIONS=3
ACTION_AGENT_MAX_STEPS=30
ACTION_MAX_RISKS_PER_RUN=4
# Hours a supplier or colleague gets to answer before the one reminder
ACTION_ANSWER_HOURS=2
# What one copy that makes day one is worth, per product, in EUR. Soony: a missed Collector's pre-order is refunded
# with EUR 120, a Standard copy carries EUR 32 margin (Dr. Maren Vogt, 21 Nov). Empty = cards show copies only.
VALUE_PER_COPY_EUR=FG-GH6-CE=120,FG-GH6-STD=32
# Below this cost the action agent orders on its own and reports it. 0 = a person approves every order.
# Can be changed while the app runs, on the Approvals page.
AUTONOMY_LIMIT_EUR=0
TOP_RISKS=5

# OpenAI
OPENAI_API_KEY=
# Small model for one-off jobs such as matching unknown CSV columns
OPENAI_MODEL_EXTRACT=gpt-6-luna
OPENAI_MODEL_AGENT=gpt-6.2-sol
# Model of the reading agent (documents, scans, mails). Defaults to OPENAI_MODEL_AGENT
OPENAI_MODEL_READER=
# USD per 1M tokens as model=input/output, comma separated
OPENAI_PRICES=gpt-6-luna=0.10/0.50,gpt-6.1-terra=1/5,gpt-6.2-sol=2/10,gpt-6.2-astra=8/40
LLM_CONCURRENCY=6
# Stop all model calls once the logged spend reaches this many US dollars (0 = no limit)
OPENAI_BUDGET_USD=15
# Send model calls to another endpoint, for example the local bridge where a Claude subagent answers instead of OpenAI
# OPENAI_BASE_URL=http://localhost:8790/v1
# OPENAI_TIMEOUT_MS=14400000
# OPENAI_MAX_RETRIES=0

# Mail. outbox = write every outgoing mail to data/outbox instead of sending it
MAIL_MODE=outbox
# Senders registered in the portal settings. Mail is only sent from these.
MAIL_ALLOWED_SENDERS=
MAIL_FROM=
MAIL_FROM_NAME=Soony Procurement
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SEC=120
# true = questions to suppliers go out without a click in the inbox. They ask, they never order.
AUTO_SEND_CLARIFICATIONS=true
# true = approving a decision card sends its mail, which is the order or the instruction itself
SEND_ON_APPROVAL=true

PORT=8787
DATA_DIR=./data
# Login for the dashboard and API. Empty = open (fine locally, required on the server)
APP_USER=soony
APP_PASSWORD=
